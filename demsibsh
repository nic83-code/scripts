‎local function updateESP()
‎    for _, other in ipairs(Players:GetPlayers()) do
‎        if other == player then continue end
‎        local char = other.Character
‎        if not char then
‎            local box = espBoxes[other]
‎            if box then box.Visible = false end
‎            continue
‎        end
‎        local root = char:FindFirstChild("HumanoidRootPart")
‎        if not root then
‎            local box = espBoxes[other]
‎            if box then box.Visible = false end
‎            continue
‎        end
‎        local armed = hasGun(other)
‎        local box = espBoxes[other]
‎        if not box then
‎            box = Instance.new("BoxHandleAdornment")
‎            box.Size = Vector3.new(3, 5, 1.5)
‎            box.Transparency = 0.3
‎            box.Adornee = root
‎            box.ZIndex = 5
‎            box.AlwaysOnTop = true
‎            box.Parent = gui
‎            espBoxes[other] = box
‎        end
‎        box.Adornee = root
‎        if espActive then
‎            box.Visible = true
‎            if armed then
‎                box.Color3 = Color3.new(1, 0, 0)
‎            else
‎                box.Color3 = Color3.new(0, 1, 0)
‎            end
‎        else
‎            box.Visible = false
‎        end
‎    end
‎    for plrKey, box in pairs(espBoxes) do
‎        if not plrKey.Parent then
‎            box:Destroy()
‎            espBoxes[plrKey] = nil
‎        end
‎    end
‎end
