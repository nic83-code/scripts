local aimbotActive = false
local espActive = false
local espBoxes = {}

local function getVaultCode()
    local map = workspace:FindFirstChild("Map")
    if not map then return "No Map" end
    local currentMap = map:FindFirstChild("CurrentMap")
    if not currentMap then return "No CurrentMap" end
    local mansion = currentMap:FindFirstChild("Mansion")
    if not mansion then return "No Mansion" end
    local vault = mansion:FindFirstChild("VaultPuzzle")
    if not vault then return "No VaultPuzzle" end
    local code = vault:FindFirstChild("CurrentCode")
    if not code then return "No CurrentCode" end
    return tostring(code.Value or code)
end

local function hasGun(plr)
    if not plr then return false end
    local backpack = plr:FindFirstChild("Backpack")
    local character = plr.Character
    if backpack then
        for _, child in ipairs(backpack:GetChildren()) do
            if child:IsA("Tool") then
                for _, gunName in ipairs(GUNS) do
                    if child.Name == gunName then return true end
                end
                if child:FindFirstChild("GunData") or child:FindFirstChild("GunSystem") then
                    return true
                end
            end
        end
    end
    if character then
        for _, child in ipairs(character:GetChildren()) do
            if child:IsA("Tool") then
                for _, gunName in ipairs(GUNS) do
                    if child.Name == gunName then return true end
                end
                if child:FindFirstChild("GunData") or child:FindFirstChild("GunSystem") then
                    return true
                end
            end
        end
    end
    return false
end

local function updateESP()
    for _, other in ipairs(Players:GetPlayers()) do
        if other == player then continue end
        local char = other.Character
        if not char then
            local box = espBoxes[other]
            if box then box.Visible = false end
            continue
        end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then
            local box = espBoxes[other]
            if box then box.Visible = false end
            continue
        end
        local armed = hasGun(other)
        local box = espBoxes[other]
        if not box then
            box = Instance.new("BoxHandleAdornment")
            box.Size = Vector3.new(3, 5, 1.5)
            box.Transparency = 0.3
            box.Adornee = root
            box.ZIndex = 5
            box.AlwaysOnTop = true
            box.Parent = gui
            espBoxes[other] = box
        end
        box.Adornee = root
        if espActive then
            box.Visible = true
            if armed then
                box.Color3 = Color3.new(1, 0, 0)
            else
                box.Color3 = Color3.new(0, 1, 0)
            end
        else
            box.Visible = false
        end
    end
    for plrKey, box in pairs(espBoxes) do
        if not plrKey.Parent then
            box:Destroy()
            espBoxes[plrKey] = nil
        end
    end
end

local function shooterAimbot()
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local camera = workspace.CurrentCamera
    local cameraPos = camera.CFrame.Position
    local target = nil
    local closest = math.huge
    for _, other in ipairs(Players:GetPlayers()) do
        if other == player then continue end
        if not other.Character then continue end
        if not hasGun(other) then continue end
        local targetRoot = other.Character:FindFirstChild("HumanoidRootPart")
        if not targetRoot then continue end
        local dist = (targetRoot.Position - root.Position).Magnitude
        if dist < closest then
            closest = dist
            target = targetRoot
        end
    end
    if not target then return end
    local targetPos = target.Position
    local head = target.Parent:FindFirstChild("Head")
    if head then targetPos = head.Position end
    camera.CFrame = CFrame.new(cameraPos, targetPos)
end

