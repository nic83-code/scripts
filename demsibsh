    else
        aimbotBtn.Text = "Aimbot: OFF"
        aimbotBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end
end)

espBtn.MouseButton1Click:Connect(function()
    espActive = not espActive
    if espActive then
        espBtn.Text = "ESP: ON"
        espBtn.BackgroundColor3 = Color3.fromRGB(30, 150, 30)
    else
        espBtn.Text = "ESP: OFF"
        espBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
    end
end)

task.spawn(function()
    while gui.Parent do
        local code = getVaultCode()
        codeLabel.Text = "Code: " .. code
        local map = workspace:FindFirstChild("Map")
        local currentMap = map and map:FindFirstChild("CurrentMap")
        if currentMap then
            debugLabel.Text = "Map: " .. currentMap.Name
        else
            debugLabel.Text = "Map: none"
        end
        if aimbotActive then
            pcall(shooterAimbot)
        end
        pcall(updateESP)
        wait(0.05)
    end
end)
